				"disableScroll": true,
				"backgroundColor": "#FFFAFB",
				"backgroundColorTop": "#FFFAFB",
				"backgroundColorBottom": "#FFFAFB",
				"initialRenderingCache": "static"
			}
		},
		{
			"path": "pages/square/index",
			"style": {
				"navigationStyle": "custom",
				"enablePullDownRefresh": false
			}
		},
		{
			"path": "pages/create/index",
			"style": {
				"navigationBarTitleText": "发布",
				"navigationBarBackgroundColor": "#ffffff",
				"navigationBarTextStyle": "black"
			}
		},
		{
			"path": "pages/profileComplete/index",
			"style": {
				"navigationBarTitleText": "完善资料",
				"navigationBarBackgroundColor": "#fffafd",
				"navigationBarTextStyle": "black",
				"enablePullDownRefresh": false
			}
		},
		{
			"path": "pages/success/index",
			"style": {
				"navigationStyle": "custom"
			}
		},
		{
			"path": "pages/detail/index",
			"style": {
				"navigationStyle": "custom"
			}
		},
		{
			"path": "pages/myRecords/index",
			"style": {
				"navigationStyle": "custom",
				"enablePullDownRefresh": true
			}
		},
		{
			"path": "pages/favorites/index",
			"style": {
				"navigationStyle": "custom",
				"enablePullDownRefresh": false
			}
		},
		{
			"path": "pages/about/index",
