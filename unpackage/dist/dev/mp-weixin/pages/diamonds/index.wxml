<view class="diamond-page data-v-f7031c8f"><view class="balance-panel data-v-f7031c8f"><text class="balance-label data-v-f7031c8f">我的钻石</text><view class="balance-row data-v-f7031c8f"><image class="diamond-icon data-v-f7031c8f" src="{{a}}" mode="aspectFit"/><text class="balance data-v-f7031c8f">{{b}}</text></view><view class="balance-actions data-v-f7031c8f"><view class="recharge-button data-v-f7031c8f" bindtap="{{c}}">充值钻石</view><view class="task-button data-v-f7031c8f" bindtap="{{d}}">做任务赚钻石</view></view></view><view class="records data-v-f7031c8f"><text class="section-title data-v-f7031c8f">最近明细</text><view wx:if="{{e}}" class="empty data-v-f7031c8f">还没有钻石记录</view><view wx:for="{{f}}" wx:for-item="record" wx:key="f" class="record-row data-v-f7031c8f"><view class="data-v-f7031c8f"><text class="record-title data-v-f7031c8f">{{record.a}}</text><text class="record-time data-v-f7031c8f">{{record.b}}</text></view><text class="{{['amount', 'data-v-f7031c8f', record.e && 'spend']}}">{{record.c}}{{record.d}}</text></view></view><view wx:if="{{g}}" class="recharge-mask data-v-f7031c8f" catchtouchmove="{{x}}" bindtap="{{y}}"><view class="recharge-sheet data-v-f7031c8f" catchtap="{{w}}"><view class="sheet-handle data-v-f7031c8f"></view><view class="sheet-head data-v-f7031c8f"><view class="data-v-f7031c8f"><text class="sheet-title data-v-f7031c8f">充值钻石</text><text class="sheet-subtitle data-v-f7031c8f">{{h}}</text></view><view class="sheet-close data-v-f7031c8f" bindtap="{{i}}">×</view></view><view class="{{['vip-double', 'data-v-f7031c8f', m && 'active']}}" bindtap="{{n}}"><view class="data-v-f7031c8f"><text class="vip-double-title data-v-f7031c8f">{{j}}</text><text class="vip-double-sub data-v-f7031c8f">{{k}}</text></view><text wx:if="{{l}}" class="vip-double-action data-v-f7031c8f">去开通</text><text wx:else class="vip-double-badge data-v-f7031c8f">2X</text></view><scroll-view class="plan-scroll data-v-f7031c8f" scroll-x show-scrollbar="{{false}}"><view class="plan-grid data-v-f7031c8f"><view wx:for="{{o}}" wx:for-item="plan" wx:key="f" class="{{['plan-item', 'data-v-f7031c8f', plan.g && 'selected']}}" bindtap="{{plan.h}}"><view wx:if="{{plan.a}}" class="recommend-badge data-v-f7031c8f">推荐</view><view wx:if="{{p}}" class="double-tag data-v-f7031c8f">VIP 双倍</view><view class="plan-diamonds data-v-f7031c8f"><image class="data-v-f7031c8f" src="{{q}}" mode="aspectFit"/><text class="data-v-f7031c8f">{{plan.b}}</text></view><text wx:if="{{r}}" class="base-diamonds data-v-f7031c8f">原 {{plan.c}} 钻</text><text class="plan-label data-v-f7031c8f">{{plan.d}}</text><text class="plan-price data-v-f7031c8f">¥{{plan.e}}</text></view></view></scroll-view><view class="{{['pay-button', 'data-v-f7031c8f', t && 'disabled']}}" bindtap="{{v}}">{{s}}</view><text class="pay-note data-v-f7031c8f">支付即表示同意《充值协议》，钻石为虚拟道具，充值后不可提现</text></view></view></view>